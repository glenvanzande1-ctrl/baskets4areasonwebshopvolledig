# --- Database / Supabase ---
# Runtime op Vercel: Supavisor Transaction pooler (poort 6543).
# Voor Prisma 6 in transaction mode: pgbouncer=true. Serverless: connection_limit=1 is een veilig startpunt.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations: Supavisor Session pooler (poort 5432) of direct connection indien beschikbaar.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:5432/postgres"

# --- Authenticatie ---
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
SEED_ADMIN_EMAIL="admin@baskets4areason.be"
SEED_ADMIN_PASSWORD="CHANGE_ME_NOW"

# --- Publieke URL ---
# Lokaal: http://localhost:3000
# Productie: https://jouwdomein.be
APP_URL="http://localhost:3000"

# --- Mollie ---
# Test: test_xxx | Productie pas na volledige live-check: live_xxx
MOLLIE_API_KEY="test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Supabase Storage (ALLEEN server-side) ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="product-images"

# --- Resend ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
EMAIL_FROM="Baskets4areason <webshop@jouwdomein.be>"

# --- Billit facturatie ---
# Voor deze persoonlijke/non-commerciële integratie gebruiken we PartyID + API key.
# Begin ALTIJD in sandbox. Productie pas na succesvolle end-to-end tests.
BILLIT_ENV="sandbox"
BILLIT_PARTY_ID=""
BILLIT_API_KEY=""
BILLIT_POS_CUSTOMER_NAME="Particuliere klant"
